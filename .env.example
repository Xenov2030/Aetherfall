# Producción: nunca activar el modo local en Vercel.
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=verify-full
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# SMTP autorizado para enlaces de acceso y recuperación; no se envían otros mensajes.
SMTP_URL=
EMAIL_FROM=
# Nube central elegida: Drive privado del máster. OAuth de usuario, no cuenta de servicio.
STORAGE_PROVIDER=drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FILES_FOLDER_ID=
GOOGLE_DRIVE_BACKUPS_FOLDER_ID=
# S3 opcional: conservar solo si hay archivos anteriores o se elige STORAGE_PROVIDER=s3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Solo desarrollo fuera de Vercel; ver README.
AETHERFALL_LOCAL=0
